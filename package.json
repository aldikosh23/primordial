{
  "name": "primordial",
  "private": true,
  "version": "1.0.0",
  "description": "An evolution sandbox that runs in your browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
